    <file alias="icons/mime-flux-motion-project.svg">icons/mime-flux-motion-project.svg</file>
    <file alias="icons/mime-flux-encoder-queue.svg">icons/mime-flux-encoder-queue.svg</file>
    <file alias="fonts/Satoshi-Regular.otf">../../../packages/flux-common/resources/fonts/Satoshi-Regular.otf</file>
    <file alias="fonts/Satoshi-Medium.otf">../../../packages/flux-common/resources/fonts/Satoshi-Medium.otf</file>
