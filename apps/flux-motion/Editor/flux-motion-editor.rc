#include <windows.h>

IDI_APPLICATION ICON "../data/icons/flux-motion-icon.ico"

#ifndef FXM_VERSION_MAJOR
#define FXM_VERSION_MAJOR 0
#define FXM_VERSION_MINOR 8
#define FXM_VERSION_PATCH 16
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FXM_VERSION_MAJOR,FXM_VERSION_MINOR,FXM_VERSION_PATCH,0
 PRODUCTVERSION FXM_VERSION_MAJOR,FXM_VERSION_MINOR,FXM_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "omniatv\0"
            VALUE "FileDescription", "Flux Motion\0"
            VALUE "FileVersion", FXM_VERSION_LABEL "\0"
            VALUE "InternalName", "Flux Motion\0"
            VALUE "OriginalFilename", "Flux Motion.exe\0"
            VALUE "ProductName", "Flux Motion\0"
            VALUE "ProductVersion", FXM_VERSION_LABEL "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
