{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flux-encoder:schema:provider-protocol:v1",
  "title": "Flux Encoder Render Provider Protocol v1",
  "type": "object",
  "required": ["protocolVersion", "requestId", "method"],
  "properties": {
    "protocolVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 1},
    "providerId": {"type": "string"},
    "sessionId": {"type": "string"},
    "method": {"enum": ["hello", "probe", "validate", "create-session", "prepare", "render-video", "render-audio", "flush", "finalize", "cancel", "heartbeat"]},
    "params": {"type": "object"}
  },
  "additionalProperties": true
}
